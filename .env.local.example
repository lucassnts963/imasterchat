# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. pt-BR, en, ko). Build-time: must be set
# when `next build` runs.
NEXT_PUBLIC_APP_LOCALE=pt-BR

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Verificação temporária do formato de cobrança do WhatsApp. Quando
# "true", cada bloco `pricing` recebido do webhook de status é logado —
# só os campos de cobrança, nunca o destinatário, que é telefone.
# Serve para conferir o formato contra tráfego real nos primeiros dias;
# desligue depois. Ver docs/cobranca-whatsapp-out-2026.md.
# WHATSAPP_LOG_PRICING=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# key under Settings → AI Assistant and picks a provider — OpenAI,
# Anthropic, DeepSeek, OpenRouter, or "custom" for any OpenAI-compatible
# endpoint (a gateway of your own, or a model you host). The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.
#
# Embeddings are configured separately from chat, because Anthropic and
# DeepSeek have no embeddings endpoint at all: those accounts point the
# embeddings key at a provider that does (OpenRouter serves baai/bge-m3).
# Migration 074 sizes the vector column at 1024 dimensions, so the
# embeddings model must return that width — the save is rejected if not.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Manual billing (migration 037)
# ------------------------------------------------------------------
# Support contact shown on the /blocked page. A URL (wa.me / mailto:)
# renders as a button; plain text renders as-is.
# NEXT_PUBLIC_BILLING_CONTACT=https://wa.me/5591999999999

# PIX key shown on the /blocked page for manual payment.
# NEXT_PUBLIC_BILLING_PIX_KEY=chave@exemplo.com

# PIX QR code image shown on the /blocked page next to the key, as a
# base64-encoded PNG (with or without the data:image/png;base64, prefix).
# Generate the base64 from your bank's static QR image with:
#   node -e "console.log(require('fs').readFileSync('qr.png').toString('base64'))"
# Keep it small (a static PIX QR is ~2-5 KB as PNG).
# NEXT_PUBLIC_BILLING_PIX_QR=iVBORw0KGgo...

# ------------------------------------------------------------------
# Tech Provider / Embedded Signup (opcional — veja docs/tech-provider.md)
# ------------------------------------------------------------------
# Sem NEXT_PUBLIC_META_ES_CONFIG_ID o botão "Conectar com o Facebook"
# não renderiza e só o formulário manual aparece.
# NEXT_PUBLIC_META_APP_ID=<mesmo valor de META_APP_ID>
# NEXT_PUBLIC_META_ES_CONFIG_ID=<config_id do Embedded Signup>

# ------------------------------------------------------------------
# Agendamento com Google Agenda (migração 043)
# ------------------------------------------------------------------
# Sem estas credenciais o botão "Conectar Google Agenda" não funciona e
# o agente não recebe as ferramentas de agendamento. Crie um projeto no
# Google Cloud Console, ative a Google Calendar API e gere um OAuth
# client do tipo "Web application".
#
# O redirect URI precisa bater byte a byte com o cadastrado lá — por
# isso é configuração, nunca derivado do Host da requisição.
# GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<secret>

# Derivado de NEXT_PUBLIC_SITE_URL quando não definido:
#   <NEXT_PUBLIC_SITE_URL>/api/google/calendar/callback
# GOOGLE_OAUTH_REDIRECT_URI=https://app.exemplo.com/api/google/calendar/callback

# ------------------------------------------------------------------
# Laço de agente (migração 042)
# ------------------------------------------------------------------
# Quantas idas ao provider uma resposta pode custar antes de o laço
# desistir e chamar humano. Sobrescrito por conta em
# ai_configs.max_tool_steps. Default 6.
# AI_MAX_TOOL_STEPS=6

# Teto de relógio para uma execução inteira do agente — todas as
# chamadas ao provider mais a execução das ferramentas. Separado do
# timeout por chamada porque seis chamadas saudáveis ainda somam uma
# espera longa demais para o cliente. Default 60000.
# AI_AGENT_TIMEOUT_MS=60000

# ------------------------------------------------------------------
# Keeper do vault (migração 046)
# ------------------------------------------------------------------
# O keeper lê conversas que ficaram quietas e propõe páginas para a wiki
# da conta. Roda por varredura agendada, não por hook de "conversa
# encerrada" — a maioria das conversas nunca é encerrada, elas só param.
#
# Aponte um cron (Vercel Cron, cron do VPS, uptime pinger) para:
#   GET /api/ai/vault/keeper
#   header: x-cron-secret: <AUTOMATION_CRON_SECRET>
#
# Usa o MESMO segredo das outras rotas agendadas, de propósito: um
# operador guarda um segredo, não uma coleção deles.
# A cada 30 minutos é suficiente — ele só olha conversas paradas há 90
# minutos e processa no máximo 10 por varredura.

# ------------------------------------------------------------------
# Notificações push / PWA (migração 051)
# ------------------------------------------------------------------
# Só existem para alcançar quem está com o app FECHADO. Com a aba
# aberta o Realtime já entrega tudo; o push é o celular no bolso da
# atendente e da dona da ótica.
#
# Gere um par próprio por ambiente (nunca reaproveite o de outro
# deploy — a chave pública fica embutida no cliente e é o que amarra
# as assinaturas dos navegadores a ESTE servidor):
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Trocar o par depois invalida todas as assinaturas já registradas:
# cada aparelho precisa reativar nas Configurações. Sem as duas
# variáveis o painel aparece, avisa que o servidor não está
# configurado, e nada quebra.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# Quem aparece como remetente para o serviço de push do navegador.
# mailto: ou https:. Default mailto:admin@imasterchat.app.
# VAPID_SUBJECT=mailto:suporte@imasterchat.com.br

# ------------------------------------------------------------------
# Alertas de falha por Telegram (migração 052)
# ------------------------------------------------------------------
# O canal por onde a plataforma avisa o OPERADOR de que algo quebrou.
# Não é WhatsApp de propósito: um alerta é mensagem iniciada pelo
# negócio, fora da janela de 24h — na Cloud API isso exige template
# aprovado e é cobrado, e o texto teria que caber num template com
# variáveis (não cabe "14 falhas de invalid_key desde as 6h").
#
# O WhatsApp continua sendo o canal do CLIENTE, onde quem inicia é ele.
#
# Como obter, uma vez:
#   1. no Telegram, fale com @BotFather e mande /newbot
#   2. ele devolve o token — é o TELEGRAM_BOT_TOKEN
#   3. mande qualquer mensagem para o bot que você acabou de criar
#   4. abra https://api.telegram.org/bot<TOKEN>/getUpdates
#      e copie o `chat.id` que aparecer — é o TELEGRAM_ALERT_CHAT_ID
#
# Para o alerta cair num grupo (mais de uma pessoa de plantão), crie o
# grupo, adicione o bot, mande uma mensagem e repita o passo 4 — o id
# de grupo é negativo.
#
# Sem as duas variáveis nada quebra: os eventos continuam sendo
# gravados e a tela em /admin → Eventos continua funcionando. Só não
# sai aviso.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_ID=
